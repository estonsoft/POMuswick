<?xml version="1.0" encoding="utf-8" ?>
<Shell
    x:Class="POMuswick.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    xmlns:fftransformations="clr-namespace:FFImageLoading.Transformations;assembly=FFImageLoading.Maui"
    xmlns:local="clr-namespace:POMuswick"
    xmlns:views="clr-namespace:POMuswick.Views"
    FlyoutBehavior="Flyout"
    FlyoutWidth="280"
    ForegroundColor="{StaticResource Primary}"
    BackgroundColor="{StaticResource Surface}">

    <Shell.Resources>
        <ResourceDictionary>
            <Style x:Key="BaseStyle"
                   TargetType="Element">
                <Setter Property="Shell.BackgroundColor"
                        Value="{StaticResource Surface}"/>
                <Setter Property="Shell.ForegroundColor"
                        Value="{StaticResource MutedInk}"/>
                <Setter Property="Shell.TitleColor"
                        Value="{StaticResource Primary}"/>
                <Setter Property="Shell.DisabledColor"
                        Value="{StaticResource Gray400}"/>
                <Setter Property="Shell.UnselectedColor"
                        Value="{StaticResource MutedInk}"/>
                <Setter Property="Shell.TabBarBackgroundColor"
                        Value="{StaticResource Surface}"/>
                <Setter Property="Shell.TabBarForegroundColor"
                        Value="{StaticResource Primary}"/>
                <Setter Property="Shell.TabBarUnselectedColor"
                        Value="{StaticResource MutedInk}"/>
                <Setter Property="Shell.TabBarTitleColor"
                        Value="{StaticResource Primary}"/>
            </Style>
            <Style BasedOn="{StaticResource BaseStyle}"
                   TargetType="TabBar"/>
            <Style BasedOn="{StaticResource BaseStyle}"
                   TargetType="FlyoutItem"/>
            <Style x:Key="FlyoutHeaderStyle"
                   TargetType="ffimageloading:CachedImage">
                <Setter Property="BackgroundColor"
                        Value="{StaticResource White}"/>
                <Setter Property="Margin"
                        Value="5"/>
            </Style>

            <!--
                Default Styles for all Flyout Items
                https://docs.microsoft.com/xamarin/xamarin-forms/app-fundamentals/shell/flyout#flyoutitem-and-menuitem-style-classes
            -->
            <Style Class="FlyoutItemLabelStyle"
                   TargetType="Label">
                <Setter Property="TextColor"
                        Value="{StaticResource Ink}"/>
                <Setter Property="FontSize"
                        Value="14"/>
                <Setter Property="HorizontalOptions"
                        Value="Fill"/>
                <Setter Property="HeightRequest"
                        Value="40"/>
            </Style>
            <Style
                ApplyToDerivedTypes="True"
                Class="FlyoutItemLayoutStyle"
                TargetType="Layout">
                <Setter Property="BackgroundColor"
                        Value="{StaticResource White}"/>
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor"
                                            Value="{StaticResource White}"/>
                                    <Setter Property="HeightRequest"
                                            Value="40"/>
                                    <!--<Setter TargetName="FlyoutItemLabel" Property="Label.TextColor" Value="{StaticResource Primary}" />-->
                                    <Setter TargetName="FlyoutItemLabel"
                                            Property="Label.TextColor"
                                            Value="{StaticResource Ink}"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Selected">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor"
                                            Value="{StaticResource SurfaceAlt}"/>
                                    <Setter Property="HeightRequest"
                                            Value="40"/>
                                    <Setter TargetName="FlyoutItemLabel"
                                            Property="Label.TextColor"
                                            Value="{StaticResource Primary}"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <Style x:Key="MyButtonStyle"
                   TargetType="Button">
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter TargetName="FlyoutItemLabel"
                                            Property="Label.TextColor"
                                            Value="{StaticResource Primary}"/>
                                    <Setter TargetName="FlyoutItemLabel"
                                            Property="Label.FontSize"
                                            Value="12"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!--
                Custom Style you can apply to any Flyout Item
            -->
            <Style
                ApplyToDerivedTypes="True"
                Class="MenuItemLayoutStyle"
                TargetType="Layout">
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter TargetName="FlyoutItemLabel"
                                            Property="Label.TextColor"
                                            Value="{StaticResource Ink}"/>
                                    <Setter TargetName="FlyoutItemLabel"
                                            Property="Label.FontSize"
                                            Value="14"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <views:ShellTitleConverter x:Key="titleConverter"/>
        </ResourceDictionary>
    </Shell.Resources>

    <Shell.FlyoutHeaderTemplate>
        <DataTemplate>
            <Grid BackgroundColor="{StaticResource Surface}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ffimageloading:CachedImage
                    Margin="6"
                    Aspect="AspectFit"
                    HeightRequest="80"
                    HorizontalOptions="Center"
                    Source="logo.jpg"
                    StyleClass="FlyoutHeaderStyle"
                    VerticalOptions="Center"/>
            </Grid>
        </DataTemplate>
    </Shell.FlyoutHeaderTemplate>

    <Shell.FlyoutFooterTemplate>
        <DataTemplate>
            <Border
                Margin="12,8"
                Padding="10,8"
                Background="{StaticResource SurfaceAlt}"
                Stroke="{StaticResource Divider}"
                StrokeShape="RoundRectangle 10"
                StrokeThickness="1">
                <Label
                    FontSize="12"
                    HorizontalTextAlignment="Center"
                    Text="{x:Static local:Constants.Version}"
                    TextColor="{StaticResource MutedInk}"/>
            </Border>
        </DataTemplate>
    </Shell.FlyoutFooterTemplate>

    <FlyoutItem Title="Home"
                FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent
            x:Name="MenuLogin"
            Title="Login  ›"
            ContentTemplate="{DataTemplate views:LoginPage}"
            Route="LoginPage"
            FlyoutItemIsVisible="False"
            Shell.NavBarIsVisible="False"
            StyleClass="MenuItemLayoutStyle">
            <ShellContent.Icon FontSize="16">
                <FontImageSource
                    FontFamily="FontAwesomeFreeSolid"
                    Glyph="&#xF015;"
                    Color="{StaticResource Primary}"/>
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent
            x:Name="MenuHome"
            Title="Home  ›"
            ContentTemplate="{DataTemplate views:HomePage}"
            Route="HomePage"
            StyleClass="MenuItemLayoutStyle">
            <ShellContent.Icon FontSize="16">
                <FontImageSource
                    FontFamily="FontAwesomeFreeSolid"
                    Glyph="&#xF015;"
                    Color="{StaticResource Primary}"/>
            </ShellContent.Icon>
        </ShellContent>
    </FlyoutItem>

    <MenuItem
        x:Name="MenuShoppingCart"
        Clicked="MenuShoppingCart_Clicked"
        StyleClass="MenuItemLayoutStyle"
        Text="Shopping Cart  ›">
        <MenuItem.IconImageSource>
            <FontImageSource
                FontFamily="FontAwesomeFreeSolid"
                Glyph="&#xF07A;"
                Color="{StaticResource Primary}"/>
        </MenuItem.IconImageSource>
    </MenuItem>
    <MenuItem
        x:Name="MenuScanBarcode"
        Clicked="MenuScanBarcode_Clicked"
        StyleClass="MenuItemLayoutStyle"
        Text="Scan Barcode  ›">
        <MenuItem.IconImageSource>
            <FontImageSource
                FontFamily="FontAwesomePro6Regular"
                Glyph="&#xF464;"
                Color="{StaticResource Primary}"/>
        </MenuItem.IconImageSource>
    </MenuItem>
    <MenuItem
        x:Name="MenuMyPurchases"
        Clicked="MenuMyPurchases_Clicked"
        StyleClass="MenuItemLayoutStyle"
        Text="Order History  ›">
        <MenuItem.IconImageSource>
            <FontImageSource
                FontFamily="FontAwesomeFreeSolid"
                Glyph="&#xF571;"
                Color="{StaticResource Primary}"/>
        </MenuItem.IconImageSource>
    </MenuItem>
    <MenuItem
        x:Name="MenuCategories"
        Clicked="MenuCategories_Clicked"
        StyleClass="MenuItemLayoutStyle"
        Text="Product Categories  ›">
        <MenuItem.IconImageSource>
            <FontImageSource
                FontFamily="FontAwesomeFreeSolid"
                Glyph="&#xF0CA;"
                Color="{StaticResource Primary}"/>
        </MenuItem.IconImageSource>
    </MenuItem>
    <MenuItem
        x:Name="MenuMyAccount"
        Clicked="MenuMyAccount_Clicked"
        StyleClass="MenuItemLayoutStyle"
        Text="My Account  ›">
        <MenuItem.IconImageSource>
            <FontImageSource
                FontFamily="FontAwesomeFreeSolid"
                Glyph="&#xF007;"
                Color="{StaticResource Primary}"/>
        </MenuItem.IconImageSource>
    </MenuItem>
    <MenuItem
        x:Name="MenuLogout"
        Clicked="MenuLogout_Clicked"
        StyleClass="MenuItemLayoutStyle"
        Text="Logout  ›">
        <MenuItem.IconImageSource>
            <FontImageSource
                FontFamily="FontAwesomeFreeSolid"
                Glyph="&#xF007;"
                Color="{StaticResource Primary}"/>
        </MenuItem.IconImageSource>
    </MenuItem>
    <MenuItem
        x:Name="MenuCustomers"
        Clicked="MenuCustomers_Clicked"
        StyleClass="MenuItemLayoutStyle"
        Text="Customers  ›">
        <MenuItem.IconImageSource>
            <FontImageSource
                FontFamily="FontAwesomeFreeSolid"
                Glyph="&#xF500;"
                Color="{StaticResource Primary}"/>
        </MenuItem.IconImageSource>
    </MenuItem>
</Shell>

