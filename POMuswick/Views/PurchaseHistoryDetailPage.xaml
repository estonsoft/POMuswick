<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="POMuswick.Views.PurchaseHistoryDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:POMuswick.Controls"
    xmlns:local="clr-namespace:POMuswick.ViewModels"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    Title="Monthly Ad"
    HideSoftInputOnTapped="True"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="BannerBackground">White</Color>
            <Color x:Key="Accent">#96d1ff</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>
        <Grid Margin="{OnPlatform iOS='0,50,0,0', Android='0'}"
                SafeAreaEdges="{OnPlatform iOS='None', Android='All'}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  HeightRequest="48"
                  Padding="14,0"
                  ColumnDefinitions="Auto,*,Auto"
                  Background="{StaticResource White}"
                  VerticalOptions="Center">
                <Button
                    Grid.Column="0"
                    Command="{Binding BackPressedCommand}"
                    FontFamily="FontAwesomeFreeSolid"
                    FontSize="18"
                    Text="&#xF060;"
                    TextColor="{StaticResource Ink}"
                    Background="Transparent"
                    Padding="0"
                    WidthRequest="36"
                    HeightRequest="36"
                    VerticalOptions="Center"/>
                <Label
                    Grid.Column="1"
                    Margin="4,0,0,0"
                    Text="{Binding Title, FallbackValue='Order Details'}"
                    FontSize="19"
                    FontAttributes="Bold"
                    TextColor="{StaticResource Ink}"
                    VerticalOptions="Center"/>
            </Grid>

            <Border Grid.Row="1"
                    Margin="14,8"
                    Padding="14"
                    Background="{StaticResource SurfaceAlt}"
                    Stroke="{StaticResource Divider}"
                    StrokeShape="RoundRectangle 16"
                    StrokeThickness="1">
                <Grid RowDefinitions="Auto,Auto"
                      RowSpacing="12">
                    <Grid Grid.Row="0"
                          ColumnDefinitions="*,Auto"
                          VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="Order #"
                                   FontSize="12"
                                   TextColor="{StaticResource MutedInk}"
                                   VerticalOptions="Center"/>
                            <Label Text="{Binding OrderNo}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Ink}"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Label Grid.Column="1"
                               Text="{Binding OrderDateDisplay}"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource MutedInk}"
                               VerticalOptions="Center"/>
                    </Grid>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="*,*,*"
                          ColumnSpacing="8">
                        <Border Grid.Column="0"
                                Padding="8,7"
                                Background="{StaticResource White}"
                                Stroke="{StaticResource Divider}"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1">
                            <VerticalStackLayout Spacing="1">
                                <Label Text="{Binding Items}"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"/>
                                <Label Text="Items"
                                       FontSize="11"
                                       TextColor="{StaticResource MutedInk}"/>
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1"
                                Padding="8,7"
                                Background="{StaticResource White}"
                                Stroke="{StaticResource Divider}"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1">
                            <VerticalStackLayout Spacing="1">
                                <Label Text="{Binding Pieces}"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"/>
                                <Label Text="Pieces"
                                       FontSize="11"
                                       TextColor="{StaticResource MutedInk}"/>
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="2"
                                Padding="8,7"
                                Background="{StaticResource White}"
                                Stroke="{StaticResource Divider}"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1">
                            <VerticalStackLayout Spacing="1">
                                <Label Text="{Binding TotalDisplay}"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"/>
                                <Label Text="Total"
                                       FontSize="11"
                                       TextColor="{StaticResource MutedInk}"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
            <CollectionView
                x:Name="OrderItemsList"
                Grid.Row="2"
                ItemsSource="{Binding OrderDetailList}"
                SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <controls:CustomListItem
                            CommandParameter="{Binding .}"
                            ImageViewCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ShowImageCommand}"
                            PlusCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.IncreaseQtyCommand}"
                            MinusCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DecreaseQtyCommand}"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <controls:ImageAlertView
                x:Name="ImageAlert"
                Grid.Row="0"
                CloseCommand="{Binding CloseImageCommand}"
                ImageSource="{Binding SelectedImage}"
                Grid.RowSpan="3"
                IsVisible="{Binding ShowImage}"
                Grid.Column="0"
                ZIndex="99"/>
            <controls:CustomToolbar Grid.Row="3"
                                    HomeCommand="{Binding HomePressedCommand}"
                                    CartCommand="{Binding CartPressedCommand}"
                                    HistoryCommand="{Binding HistoryPressedCommand}"
                                    ShopCommand="{Binding ShopPressedCommand}"
                                    ScanCommand="{Binding ScanPressedCommand}"/>
        </Grid>
    </ContentPage.Content>
</ContentPage>
