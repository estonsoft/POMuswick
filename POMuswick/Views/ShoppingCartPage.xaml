<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="POMuswick.Views.ShoppingCartPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:POMuswick.Controls"
    xmlns:local="clr-namespace:POMuswick.ViewModels"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    Title="Shopping Cart"
    HideSoftInputOnTapped="True">

    <ContentPage.Resources>
        <ResourceDictionary>
            <controls:StringToColorConverter x:Key="StringToColorConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid Margin="{OnPlatform iOS='0,50,0,0', Android='0'}"
          SafeAreaEdges="{OnPlatform iOS='None', Android='All'}"
          RowDefinitions="Auto, Auto, *, Auto, 80">

        <!--  0. TOP HEADER: TITLE + CART COUNT BADGE + GLYPH CLEAR ALL  -->
        <Grid Grid.Row="0"
              HeightRequest="48"
              Padding="14,0"
              ColumnDefinitions="Auto, Auto, Auto, *, Auto"
              VerticalOptions="Center">

            <!-- Back Arrow Button -->
            <Button
                Grid.Column="0"
                Command="{Binding BackPressedCommand}"
                FontFamily="FontAwesomeFreeSolid"
                FontSize="18"
                Text="&#xF060;"
                TextColor="#FF271717"
                Background="Transparent"
                Padding="0"
                WidthRequest="36"
                HeightRequest="36"
                VerticalOptions="Center"/>

            <!-- Page Title -->
            <Label
                Grid.Column="1"
                Margin="4,0,0,0"
                Text="{Binding Title, FallbackValue='Cart'}"
                FontSize="19"
                FontAttributes="Bold"
                TextColor="{StaticResource Ink}"
                VerticalOptions="Center"/>

            <!-- Cart Items Count Badge -->
            <Border
                Grid.Column="2"
                Margin="10,0,0,0"
                Padding="8,2"
                Background="{StaticResource SurfaceAlt}"
                Stroke="{StaticResource Divider}"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="1"
                VerticalOptions="Center">
                <HorizontalStackLayout Spacing="3">
                    <Label
                        Text="{Binding CartItems}"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Primary}"/>
                    <Label
                        Text="items"
                        FontSize="12"
                        TextColor="{StaticResource MutedInk}"/>
                </HorizontalStackLayout>
            </Border>

            <!-- Clear All Glyph Button in Top Right -->
            <Border
                Grid.Column="4"
                Padding="12,7"
                Background="{StaticResource White}"
                Stroke="{StaticResource Primary}"
                StrokeShape="RoundRectangle 10"
                StrokeThickness="1"
                VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ClearCartCommand}"/>
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="6"
                                       VerticalOptions="Center">
                    <!-- FontAwesome Trash Glyph -->
                    <Label
                        FontFamily="FontAwesomeFreeSolid"
                        FontSize="14"
                        Text="&#xF2ED;"
                        TextColor="#FFFF0015"
                        VerticalOptions="Center"/>
                    <!-- Action Text -->
                    <Label
                        Text="Clear All"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Ink}"
                        VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!--  1. FULFILLMENT SELECTOR (DELIVERY / PICKUP TOGGLE)  -->
        <Border Grid.Row="1"
                Margin="16,6,16,8"
                Padding="3"
                Background="{StaticResource SurfaceAlt}"
                Stroke="{StaticResource Divider}"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="1">
            <Grid ColumnDefinitions="*, *">

                <!-- DELIVERY TAB -->
                <Border Grid.Column="0"
                        Padding="0,9"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        Background="{Binding IsDeliveryHighlighted, Converter={StaticResource BoolToBgConverter}, FallbackValue=Transparent}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding DeliveryCommand}"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout HorizontalOptions="Center"
                                           Spacing="8">
                        <Label FontFamily="FontAwesomeFreeSolid"
                               FontSize="15"
                               Text="&#xF0D1;"
                               TextColor="{StaticResource Primary}"
                               VerticalOptions="Center"/>
                        <Label FontSize="13"
                               FontAttributes="Bold"
                               Text="Delivery"
                               TextColor="{StaticResource Ink}"
                               VerticalOptions="Center"/>
                        <Label FontFamily="FontAwesomeFreeSolid"
                               FontSize="13"
                               Text="&#xF00C;"
                               TextColor="{StaticResource Primary}"
                               IsVisible="{Binding IsDeliveryHighlighted}"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- PICKUP TAB -->
                <Border Grid.Column="1"
                        Padding="0,9"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        Background="{Binding IsPickupHighlighted, Converter={StaticResource BoolToBgConverter}, FallbackValue=Transparent}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PickupCommand}"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout HorizontalOptions="Center"
                                           Spacing="8">
                        <Label FontFamily="FontAwesomeFreeSolid"
                               FontSize="15"
                               Text="&#xF474;"
                               TextColor="{StaticResource Primary}"
                               VerticalOptions="Center"/>
                        <Label FontSize="13"
                               FontAttributes="Bold"
                               Text="Pickup"
                               TextColor="{StaticResource Ink}"
                               VerticalOptions="Center"/>
                        <Label FontFamily="FontAwesomeFreeSolid"
                               FontSize="13"
                               Text="&#xF00C;"
                               TextColor="{StaticResource Primary}"
                               IsVisible="{Binding IsPickupHighlighted}"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Border>

        <!--  2. CART ITEMS LIST VIEW  -->
        <CollectionView
            x:Name="ItemsListCart"
            Grid.Row="2"
            Margin="14,4,14,0"
            ItemsSource="{Binding CartItemList}"
            SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"
                                   ItemSpacing="8"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <controls:CustomListItem
                        CommandParameter="{Binding .}"
                        ImageViewCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ShowImageCommand}"
                        PlusCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.IncreaseQtyCommand}"
                        MinusCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DecreaseQtyCommand}"/>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!--  3. BOTTOM SUMMARY & CHECKOUT CARD  -->
        <Border Grid.Row="3"
                Margin="14,6,14,8"
                Padding="16,12"
                Background="{StaticResource SurfaceAlt}"
                Stroke="{StaticResource Divider}"
                StrokeShape="RoundRectangle 16"
                StrokeThickness="1">
            <Border.Shadow>
                <Shadow Brush="#000000"
                        Offset="0,-3"
                        Radius="8"
                        Opacity="0.05"/>
            </Border.Shadow>

            <Grid RowDefinitions="Auto, Auto"
                  RowSpacing="10">

                <!-- Metrics Bar -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="*, *"
                      ColumnSpacing="8"
                      VerticalOptions="Center">
                    <Border Grid.Column="0"
                            Padding="10,8"
                            Background="{StaticResource White}"
                            Stroke="{StaticResource Divider}"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="1">
                        <HorizontalStackLayout Spacing="5"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center">
                            <Label Text="{Binding CartPieces}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"/>
                            <Label Text="Total Pieces"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Ink}"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                    <Border Grid.Column="1"
                            Padding="10,8"
                            Background="{StaticResource White}"
                            Stroke="{StaticResource Divider}"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="1">
                        <HorizontalStackLayout Spacing="5"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center">
                            <Label Text="Total:"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Ink}"
                                   VerticalOptions="Center"/>
                            <Label Text="{Binding CartTotal, StringFormat='${0}'}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- Action Button -->
                <Grid Grid.Row="1">
                    <Button
                        x:Name="btnCheckout"
                        Background="{StaticResource Primary}"
                        Command="{Binding CheckoutCommand}"
                        CornerRadius="12"
                        HeightRequest="46"
                        Text="Validate Order"
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="{StaticResource White}"
                        IsVisible="{Binding IsSignInVisible, Converter={StaticResource InverseBoolConverter}}"
                        HorizontalOptions="Fill"/>

                    <Button
                        x:Name="btnSignIn"
                        Background="{StaticResource Primary}"
                        Command="{Binding SignInCommand}"
                        CornerRadius="12"
                        HeightRequest="46"
                        Text="Sign In to Checkout"
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="{StaticResource White}"
                        IsVisible="{Binding IsSignInVisible}"
                        HorizontalOptions="Fill"/>
                </Grid>

            </Grid>
        </Border>

        <!--  4. ALERT / LOADING OVERLAY  -->
        <controls:CustomAlertDialog
            x:Name="LoadingAlert"
            Title="Validating"
            Grid.Row="0"
            Grid.RowSpan="4"
            IsLoading="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            Message="Please wait while we validating the order…"/>

        <!--  5. BOTTOM TOOLBAR (FIXED 80)  -->

    </Grid>
</ContentPage>