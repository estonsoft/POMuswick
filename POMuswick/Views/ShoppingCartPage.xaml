<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="POMuswick.Views.ShoppingCartPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:POMuswick.Controls"
    xmlns:local="clr-namespace:POMuswick.ViewModels"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    Title="Shopping Cart"
    HideSoftInputOnTapped="True"
    Shell.TabBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <controls:StringToColorConverter x:Key="StringToColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid Margin="{OnPlatform iOS='0,50,0,0', Android='0'}" SafeAreaEdges="{OnPlatform iOS='None', Android='All'}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="80" />
        </Grid.RowDefinitions>

        <!--  HEADER  -->
        <controls:CustomHeader Grid.Row="0" />

        <VerticalStackLayout Grid.Row="1">

            <!--  DELIVERY  -->
            <Border
                x:Name="Delivery"
                Margin="5"
                BackgroundColor="LightGray"
                HorizontalOptions="Fill"
                Stroke="White"
                StrokeShape="RoundRectangle 5">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDelivery" />
                </Border.GestureRecognizers>

                <Grid
                    Padding="5"
                    ColumnDefinitions="Auto,*,Auto"
                    VerticalOptions="Center">

                    <!--  Truck icon  -->
                    <Label
                        Grid.Column="0"
                        Margin="5"
                        FontFamily="FontAwesomeFreeSolid"
                        FontSize="18"
                        Text="&#xF0D1;"
                        TextColor="Blue"
                        VerticalOptions="Center" />

                    <!--  Label  -->
                    <Label
                        Grid.Column="1"
                        Margin="5"
                        FontSize="16"
                        Text="Delivery"
                        TextColor="Blue"
                        VerticalOptions="Center" />

                    <!--  Checkmark pinned to right  -->
                    <Label
                        Grid.Column="2"
                        Margin="5"
                        FontFamily="FontAwesomeFreeSolid"
                        FontSize="18"
                        IsVisible="{Binding IsDeliveryHighlighted}"
                        Text="&#xF00C;"
                        TextColor="Blue"
                        VerticalOptions="Center" />

                </Grid>
            </Border>

            <!--  PICKUP  -->
            <Border
                x:Name="Pickup"
                Margin="5,0,5,0"
                BackgroundColor="LightGray"
                HorizontalOptions="Fill"
                Stroke="White"
                StrokeShape="RoundRectangle 5">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPickup" />
                </Border.GestureRecognizers>

                <Grid
                    Padding="5"
                    ColumnDefinitions="Auto,*,Auto"
                    VerticalOptions="Center">

                    <!--  Pin icon  -->
                    <Label
                        Grid.Column="0"
                        Margin="5"
                        FontFamily="FontAwesomeFreeSolid"
                        FontSize="18"
                        Text="&#xF474;"
                        TextColor="Blue"
                        VerticalOptions="Center" />

                    <!--  Label  -->
                    <Label
                        Grid.Column="1"
                        Margin="5"
                        FontSize="16"
                        Text="Pickup"
                        TextColor="Blue"
                        VerticalOptions="Center" />

                    <!--  Checkmark pinned to right  -->
                    <Label
                        Grid.Column="2"
                        Margin="5"
                        FontFamily="FontAwesomeFreeSolid"
                        FontSize="18"
                        IsVisible="{Binding IsPickupHighlighted}"
                        Text="&#xF00C;"
                        TextColor="Blue"
                        VerticalOptions="Center" />

                </Grid>
            </Border>

        </VerticalStackLayout>
        <!--  SUMMARY + ACTIONS  -->
        <Grid
            Grid.Row="2"
            Padding="10"
            ColumnDefinitions="*,Auto">

            <!--  LEFT INFO  -->
            <VerticalStackLayout Spacing="4">
                <HorizontalStackLayout>
                    <Label Text="Items:" WidthRequest="70" />
                    <Label FontAttributes="Bold" Text="{Binding CartItems}" />
                </HorizontalStackLayout>

                <HorizontalStackLayout>
                    <Label Text="Pieces:" WidthRequest="70" />
                    <Label FontAttributes="Bold" Text="{Binding CartPieces}" />
                </HorizontalStackLayout>

                <HorizontalStackLayout>
                    <Label Text="Total:" WidthRequest="70" />
                    <Label FontAttributes="Bold" Text="{Binding CartTotal}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!--  BUTTONS  -->
            <VerticalStackLayout Grid.Column="1" Spacing="6">
                <Button
                    x:Name="btnCheckout"
                    BackgroundColor="Blue"
                    Clicked="btnCheckout_Clicked"
                    Command="{Binding OpenCheckout}"
                    CornerRadius="10"
                    HeightRequest="35"
                    Text="Validate Order"
                    TextColor="White"
                    WidthRequest="250" />

                <Button
                    x:Name="btnSignIn"
                    BackgroundColor="Blue"
                    Clicked="btnSignIn_Clicked"
                    Command="{Binding OpenSignIn}"
                    CornerRadius="10"
                    HeightRequest="35"
                    Text="Sign In"
                    TextColor="White"
                    WidthRequest="130" />
            </VerticalStackLayout>

        </Grid>

        <!--  TITLE BAR  -->
        <Grid Grid.Row="3" RowDefinitions="Auto,1,*">

            <HorizontalStackLayout
                Grid.Row="0"
                Padding="10"
                HorizontalOptions="Center">

                <Label
                    FontAttributes="Bold"
                    FontSize="20"
                    Text="Items"
                    TextColor="Blue"
                    VerticalOptions="Center" />

                <ImageButton
                    x:Name="btnClearCart"
                    Margin="20,0,0,0"
                    BackgroundColor="Transparent"
                    Clicked="btnClearCart_Clicked"
                    HeightRequest="28"
                    Source="delete.png"
                    WidthRequest="28" />
            </HorizontalStackLayout>

            <BoxView
                Grid.Row="1"
                BackgroundColor="Gray"
                HeightRequest="1"
                Color="LightGray" />

            <BoxView
                Grid.Row="1"
                BackgroundColor="Gray"
                HeightRequest="1"
                Color="LightGray" />

            <CollectionView
                x:Name="ItemsListCart"
                Grid.Row="2"
                Margin="0,10,0,0"
                ItemsSource="{Binding CartItemList}"
                SelectionMode="None">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <controls:CustomListItem />
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </Grid>

        <controls:CustomAlertDialog
            x:Name="LoadingAlert"
            Title="Validating"
            Grid.Row="0"
            Grid.RowSpan="4"
            IsLoading="True"
            IsVisible="False"
            Message="Please wait while we validating the order…" />

        <!--  BOTTOM TOOLBAR (FIXED 80)  -->
        <controls:CustomToolbar Grid.Row="4" HeightRequest="80" />

    </Grid>
</ContentPage>
