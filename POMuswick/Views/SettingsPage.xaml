<?xml version="1.0" encoding="utf-8" ?>
<ContentPage HideSoftInputOnTapped="True"
             x:Class="POMuswick.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:POMuswick.Controls"
             xmlns:vm="clr-namespace:POMuswick.ViewModels"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             x:DataType="vm:SettingViewModel"
             Title="Settings"
             Background="{StaticResource Surface}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <ContentPage.Content>
        <Grid Margin="{OnPlatform iOS='0,50,0,0', Android='0'}"
              SafeAreaEdges="{OnPlatform iOS='None', Android='All'}"
              RowDefinitions="52,*">

            <controls:CustomHeader Grid.Row="0"
                                   Title="{Binding Title}"
                                   BackCommand="{Binding BackPressedCommand}"/>
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="16,16,16,24"
                                     Spacing="16">
                    <Border Padding="18"
                            Background="{StaticResource White}"
                            Stroke="{StaticResource Divider}"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="1">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Server URL"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   TextColor="{StaticResource Ink}"/>
                            <Entry x:Name="ServerURL"
                                   HeightRequest="48"
                                   Placeholder="https://example.com"
                                   PlaceholderColor="{StaticResource MutedInk}"
                                   Text="{Binding ServerURLText, Mode=TwoWay}"
                                   TextColor="{StaticResource Ink}"
                                   BackgroundColor="{StaticResource SurfaceAlt}"
                                   Keyboard="Url"/>
                        </VerticalStackLayout>
                    </Border>

                    <Button x:Name="SaveButton"
                            Command="{Binding SaveSettingCommand}"
                            Text="Save"
                            HorizontalOptions="Fill"
                            TextTransform="None"/>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </ContentPage.Content>
</ContentPage>