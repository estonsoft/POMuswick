<?xml version="1.0" encoding="utf-8" ?>
<ContentPage HideSoftInputOnTapped="True"
             x:Class="POMuswick.Views.MyAccountPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:POMuswick.Controls"
             xmlns:vm="clr-namespace:POMuswick.ViewModels"
             x:DataType="vm:AccountViewModel"
             Title="My Account"
             Background="{StaticResource Surface}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <ContentPage.Content>
        <Grid Margin="{OnPlatform iOS='0,50,0,0', Android='0'}"
              SafeAreaEdges="{OnPlatform iOS='None', Android='All'}"
              RowDefinitions="52,*">

            <controls:CustomHeader Grid.Row="0"
                                   Title="{Binding Title}"
                                   BackCommand="{Binding BackPressedCommand}"/>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="16,12,16,24"
                                     Spacing="14">
                    <Border Padding="18"
                            Background="{StaticResource White}"
                            Stroke="{StaticResource Divider}"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="1">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Business Profile"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   TextColor="{StaticResource Tertiary}"/>
                            <BoxView HeightRequest="1"
                                     BackgroundColor="{StaticResource Divider}"/>
                            <Label x:Name="CompanyName"
                                   Text="{Binding CompanyNameText}"
                                   FontAttributes="Bold"
                                   FontSize="20"
                                   TextColor="{StaticResource Ink}"/>
                            <Label x:Name="Address"
                                   Text="{Binding AddressText}"
                                   FontSize="14"
                                   TextColor="{StaticResource Ink}"/>
                            <Label x:Name="CityStateZip"
                                   Text="{Binding CityStateZipText}"
                                   FontSize="14"
                                   TextColor="{StaticResource MutedInk}"/>
                            <Label x:Name="Phone"
                                   Text="{Binding PhoneText}"
                                   FontSize="14"
                                   TextColor="{StaticResource Ink}"/>
                            <Label x:Name="Email"
                                   Text="{Binding EmailText}"
                                   FontSize="14"
                                   TextColor="{StaticResource Ink}"/>
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="12">
                        <Border Grid.Column="0"
                                Padding="16"
                                Background="{StaticResource SurfaceAlt}"
                                Stroke="{StaticResource Divider}"
                                StrokeShape="RoundRectangle 14"
                                StrokeThickness="1">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Credit Limit"
                                       FontSize="12"
                                       TextColor="{StaticResource MutedInk}"/>
                                <Label x:Name="CreditLimit"
                                       Text="{Binding CreditLimitText}"
                                       FontAttributes="Bold"
                                       FontSize="18"
                                       TextColor="{StaticResource Primary}"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1"
                                Padding="16"
                                Background="{StaticResource SurfaceAlt}"
                                Stroke="{StaticResource Divider}"
                                StrokeShape="RoundRectangle 14"
                                StrokeThickness="1">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="AR Balance"
                                       FontSize="12"
                                       TextColor="{StaticResource MutedInk}"/>
                                <Label x:Name="ARBalance"
                                       Text="{Binding ARBalanceText}"
                                       FontAttributes="Bold"
                                       FontSize="18"
                                       TextColor="{StaticResource Ink}"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>

        </Grid>
    </ContentPage.Content>
</ContentPage>
