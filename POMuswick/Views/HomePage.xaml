<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="POMuswick.Views.HomePage"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Controls="clr-namespace:POMuswick.Controls"
    x:Name="HomeRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:controls="clr-namespace:POMuswick.Controls"
    xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    xmlns:fftransformations="clr-namespace:FFImageLoading.Transformations;assembly=FFImageLoading.Maui"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:vm="clr-namespace:POMuswick.ViewModels"
    Title="Muswick Wholesale Grocers"
    BackgroundColor="{StaticResource Surface}"
    HideSoftInputOnTapped="True"
    NavigationPage.HasNavigationBar="False">

    <NavigationPage.TitleView>
        <StackLayout
            Orientation="Horizontal"
            Spacing="10"
            VerticalOptions="Center">

            <Label
                Padding="10,0,0,0"
                FontSize="16"
                Text="Muswick Wholesale Grocers"
                TextColor="{StaticResource Ink}"
                VerticalTextAlignment="Center"/>
        </StackLayout>
    </NavigationPage.TitleView>

    <Shell.SearchHandler>
        <controls:MySearchHandler
            x:Name="SearchBox"
            Placeholder="Search Products"
            ShowsResults="false"/>
    </Shell.SearchHandler>

    <Grid Margin="{OnPlatform iOS='0,50,0,0', Android='0'}"
          SafeAreaEdges="{OnPlatform iOS='None', Android='All'}"
          BackgroundColor="{StaticResource Surface}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="16,12,16,8"
            Padding="12,10"
            BackgroundColor="{StaticResource White}"
            Stroke="{StaticResource Divider}"
            StrokeShape="RoundRectangle 16"
            StrokeThickness="1">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="10">
                <Label
                    Grid.Column="0"
                    FontFamily="FontAwesomeFreeSolid"
                    FontSize="18"
                    Text="&#xF0C9;"
                    TextColor="{StaticResource Primary}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding MenuTappedCommand}"/>
                    </Label.GestureRecognizers>
                </Label>

                <Entry
                    x:Name="SearchText"
                    Grid.Column="1"
                    Margin="0"
                    ClearButtonVisibility="WhileEditing"
                    FontSize="14"
                    HeightRequest="42"
                    Placeholder="Search Products"
                    PlaceholderColor="{StaticResource MutedInk}"
                    Text="{Binding SearchText, Mode=TwoWay}"/>

                <Label
                    Grid.Column="2"
                    FontFamily="FontAwesomeFreeSolid"
                    FontSize="16"
                    Text="&#xF002;"
                    TextColor="{StaticResource Primary}"
                    VerticalOptions="Center"
                    HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SearchTappedCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1"
                    Orientation="Vertical">
            <VerticalStackLayout Padding="16,0,16,16"
                                 Spacing="16">

                <Border
                    Background="{StaticResource SurfaceAlt}"
                    Stroke="{StaticResource Divider}"
                    StrokeShape="RoundRectangle 18"
                    StrokeThickness="1">
                    <Grid Padding="18"
                          RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="8">
                        <Label
                            x:Name="lblWelcome"
                            FontSize="13"
                            FontAttributes="Bold"
                            Text="{Binding WelcomeTitle}"
                            TextColor="{StaticResource Primary}"
                            TextTransform="Uppercase"/>

                        <Label
                            x:Name="lblUserName"
                            Grid.Row="1"
                            FontSize="24"
                            FontAttributes="Bold"
                            Text="{Binding CustomerTitle}"
                            TextColor="{StaticResource Ink}"/>

                        <Label
                            Grid.Row="2"
                            FontSize="13"
                            Text="Your essentials are ready for the next order."
                            TextColor="{StaticResource MutedInk}"/>
                    </Grid>
                </Border>

                <Border
                    BackgroundColor="{StaticResource White}"
                    Stroke="{StaticResource Divider}"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,1">
                            <GradientStop Offset="0"
                                          Color="{StaticResource White}"/>
                            <GradientStop Offset="1"
                                          Color="{StaticResource SurfaceAlt}"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <ffimageloading:CachedImage
                        x:Name="BannerImage"
                        Aspect="AspectFit"
                        Source="{Binding BannerImage}"
                        HeightRequest="180"
                        HorizontalOptions="Fill"
                        Margin="10"/>
                </Border>

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="12">
                    <Border Grid.Column="0"
                            Background="{StaticResource White}"
                            Stroke="{StaticResource Divider}"
                            StrokeShape="RoundRectangle 16"
                            StrokeThickness="1">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PastPurchasesCommand}"/>
                        </Border.GestureRecognizers>
                        <Grid Padding="14"
                              ColumnDefinitions="Auto,*"
                              ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   FontFamily="FontAwesomeFreeSolid"
                                   FontSize="22"
                                   Text="&#xF571;"
                                   TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="2"
                                                 VerticalOptions="Center">
                                <Label Text="Past Purchases"
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       TextColor="{StaticResource Ink}"/>
                                <Label Text="Buy again"
                                       FontSize="12"
                                       TextColor="{StaticResource MutedInk}"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            Background="{StaticResource White}"
                            Stroke="{StaticResource Divider}"
                            StrokeShape="RoundRectangle 16"
                            StrokeThickness="1">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding RefreshDataCommand}"/>
                        </Border.GestureRecognizers>
                        <Grid Padding="14"
                              ColumnDefinitions="Auto,*"
                              ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   FontFamily="FontAwesomeFreeSolid"
                                   FontSize="22"
                                   Text="&#xf021;"
                                   TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="2"
                                                 VerticalOptions="Center">
                                <Label Text="Refresh Data"
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       TextColor="{StaticResource Ink}"/>
                                <Label Text="Sync inventory"
                                       FontSize="12"
                                       TextColor="{StaticResource MutedInk}"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Padding="0,4,0,0"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                    <Label
                        FontAttributes="Bold"
                        FontSize="20"
                        Text="Start Your Cart"
                        TextColor="{StaticResource Ink}"/>
                    <HorizontalStackLayout Grid.Column="1"
                                           VerticalOptions="Center"
                                           Spacing="4">
                        <Label Text="View more"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"/>
                        <Label FontFamily="FontAwesomeFreeSolid"
                               FontSize="11"
                               Text="&#xF061;"
                               TextColor="{StaticResource Primary}"/>
                    </HorizontalStackLayout>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShopNowCommand}"/>
                    </Grid.GestureRecognizers>
                </Grid>

                <CollectionView
                    x:Name="CartSection"
                    HeightRequest="280"
                    ItemsSource="{Binding LstItems}"
                    ItemsLayout="HorizontalList"
                    SelectionMode="None"
                    HorizontalScrollBarVisibility="Never">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <controls:HomePageCells/>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Grid Padding="0,4,0,0"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                    <Label
                        FontAttributes="Bold"
                        FontSize="20"
                        Text="New Items"
                        TextColor="{StaticResource Ink}"/>
                    <HorizontalStackLayout Grid.Column="1"
                                           VerticalOptions="Center"
                                           Spacing="4">
                        <Label Text="View more"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"/>
                        <Label FontFamily="FontAwesomeFreeSolid"
                               FontSize="11"
                               Text="&#xF061;"
                               TextColor="{StaticResource Primary}"/>
                    </HorizontalStackLayout>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NewItemsAllCommand}"/>
                    </Grid.GestureRecognizers>
                </Grid>

                <CollectionView
                    x:Name="NewItemList"
                    HeightRequest="280"
                    ItemsSource="{Binding LstItems}"
                    ItemsLayout="HorizontalList"
                    SelectionMode="None"
                    HorizontalScrollBarVisibility="Never">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <controls:HomePageCells/>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>


        <controls:CustomAlertDialog
            x:Name="LoadingAlert"
            Title="Refreshing Data"
            Grid.Row="0"
            Grid.RowSpan="2"
            IsVisible="{Binding IsBusy}"
            IsLoading="{Binding IsBusy}"
            SyncStatus="{Binding SyncStatus}"
            ProgressPercentage="{Binding ProgressPercentage}"
            ProgressValue="{Binding ProgressValue}"
            Message="Please wait while we refresh app data..."/>
    </Grid>
</ContentPage>
