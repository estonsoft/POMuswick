<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="POMuswick.Views.CustomerListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ListCollection="clr-namespace:System.Collections.Generic;assembly=netstandard"
    xmlns:controls="clr-namespace:POMuswick.Controls"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    Title="Customers"
    Background="{StaticResource Surface}"
    HideSoftInputOnTapped="True"
    Shell.NavBarIsVisible="false">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="BannerBackground">{StaticResource Surface}</Color>
            <Color x:Key="Accent">{StaticResource Primary}</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>
        <Grid Margin="{OnPlatform iOS='0,50,0,0', Android='0'}"
              SafeAreaEdges="{OnPlatform iOS='None', Android='All'}">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  HeightRequest="52"
                  Padding="14,0"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="8"
                  VerticalOptions="Center">
                <Button
                    Grid.Column="0"
                    Command="{Binding BackPressedCommand}"
                    FontFamily="FontAwesomeFreeSolid"
                    FontSize="18"
                    Text="&#xF060;"
                    TextColor="{StaticResource Ink}"
                    Background="Transparent"
                    Padding="0"
                    WidthRequest="36"
                    HeightRequest="36"
                    VerticalOptions="Center"/>
                <Label
                    Grid.Column="1"
                    Margin="4,0,0,0"
                    Text="{Binding Title, FallbackValue='Customers'}"
                    FontSize="19"
                    FontAttributes="Bold"
                    TextColor="{StaticResource Ink}"
                    VerticalOptions="Center"/>
            </Grid>
            <Border Grid.Row="1"
                    Margin="14,6,14,4"
                    Padding="8,2"
                    Background="{StaticResource White}"
                    Stroke="{StaticResource Divider}"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="1">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                    <Entry
                        x:Name="CustomerSearch"
                        Grid.Column="0"
                        ClearButtonVisibility="WhileEditing"
                        FontSize="14"
                        HeightRequest="40"
                        HorizontalOptions="Fill"
                        Placeholder="Search Customers"
                        Text="{Binding CustomerSearchText, Mode=TwoWay}"
                        PlaceholderColor="{StaticResource MutedInk}"
                        VerticalOptions="Center"/>
                    <Label Grid.Column="1"
                           Margin="4,0,6,0"
                           FontFamily="FontAwesomeFreeSolid"
                           FontSize="16"
                           Text="&#xF002;"
                           TextColor="{StaticResource Primary}"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SearchCustomerCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
            </Border>
            <Grid Grid.Row="2"
                  HorizontalOptions="Fill"
                  VerticalOptions="Fill">
                <CollectionView
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    ItemsSource="{Binding Customers}"
                    x:Name="CustomerList"
                    SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="12,4"
                                Padding="14"
                                Background="{StaticResource White}"
                                Stroke="{StaticResource Divider}"
                                StrokeShape="RoundRectangle 14"
                                StrokeThickness="1">
                                <Border.Shadow>
                                    <Shadow Brush="{StaticResource Ink}"
                                            Offset="0,3"
                                            Radius="8"
                                            Opacity="0.05"/>
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectedCustomerCommand}"
                                                          CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                      RowSpacing="8">
                                    <Grid Grid.Row="0"
                                          ColumnDefinitions="Auto,*,Auto"
                                          ColumnSpacing="8">
                                        <Label
                                            Grid.Column="0"
                                            Background="{StaticResource SurfaceAlt}"
                                            Padding="7,3"
                                            FontAttributes="Bold"
                                            FontSize="12"
                                            Text="{Binding CustNo}"
                                            TextColor="{StaticResource Primary}"
                                            VerticalOptions="Center"/>
                                        <Label
                                            Grid.Column="1"
                                            FontAttributes="Bold"
                                            FontSize="15"
                                            Text="{Binding CompanyName}"
                                            TextColor="{StaticResource Ink}"
                                            VerticalOptions="Center"/>
                                        <Label Grid.Column="2"
                                               FontFamily="FontAwesomeFreeSolid"
                                               FontSize="13"
                                               Text="&#xF054;"
                                               TextColor="{StaticResource Primary}"
                                               VerticalOptions="Center"/>
                                    </Grid>
                                    <VerticalStackLayout Grid.Row="1"
                                                         Spacing="2">
                                        <Label FontSize="12"
                                               Text="{Binding Address1}"
                                               TextColor="{StaticResource Ink}"/>
                                        <Label FontSize="12"
                                               Text="{Binding CityStateZip}"
                                               TextColor="{StaticResource MutedInk}"/>
                                        <Label FontSize="12"
                                               Text="{Binding Phone}"
                                               TextColor="{StaticResource MutedInk}"/>
                                    </VerticalStackLayout>
                                    <Grid Grid.Row="2"
                                          ColumnDefinitions="*,*"
                                          ColumnSpacing="8">
                                        <Border Padding="8,5"
                                                Background="{StaticResource SurfaceAlt}"
                                                Stroke="{StaticResource Divider}"
                                                StrokeShape="RoundRectangle 8"
                                                StrokeThickness="1">
                                            <HorizontalStackLayout Spacing="4">
                                                <Label FontSize="11"
                                                       Text="Credit"
                                                       TextColor="{StaticResource MutedInk}"/>
                                                <Label FontSize="11"
                                                       FontAttributes="Bold"
                                                       Text="{Binding CreditLimitDisplay}"
                                                       TextColor="{StaticResource Ink}"/>
                                            </HorizontalStackLayout>
                                        </Border>
                                        <Border Grid.Column="1"
                                                Padding="8,5"
                                                Background="{StaticResource SurfaceAlt}"
                                                Stroke="{StaticResource Divider}"
                                                StrokeShape="RoundRectangle 8"
                                                StrokeThickness="1">
                                            <HorizontalStackLayout Spacing="4">
                                                <Label FontSize="11"
                                                       Text="Due"
                                                       TextColor="{StaticResource MutedInk}"/>
                                                <Label FontSize="11"
                                                       FontAttributes="Bold"
                                                       Text="{Binding ARBalanceDisplay}"
                                                       TextColor="{StaticResource Ink}"/>
                                            </HorizontalStackLayout>
                                        </Border>
                                    </Grid>
                                    <Grid Grid.Row="3"
                                          ColumnDefinitions="*,*"
                                          ColumnSpacing="8">
                                        <Label FontSize="11"
                                               FontAttributes="Bold"
                                               Text="{Binding TermsDesc}"
                                               TextColor="{StaticResource MutedInk}"/>
                                        <Label Grid.Column="1"
                                               FontSize="11"
                                               HorizontalTextAlignment="End"
                                               Text="{Binding LastOrderDate}"
                                               TextColor="{StaticResource MutedInk}"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
            <controls:CustomAlertDialog
                x:Name="LoadingAlert"
                Title="Updating Customer"
                Grid.Row="1"
                Grid.RowSpan="3"
                IsVisible="{Binding IsBusy}"
                IsLoading="{Binding IsBusy}"
                SyncStatus="{Binding SyncStatus}"
                ProgressPercentage="{Binding ProgressPercentage}"
                ProgressValue="{Binding ProgressValue}"
                Message="Please wait while we update the customer..."/>
        </Grid>
    </ContentPage.Content>
</ContentPage>
