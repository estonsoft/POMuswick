<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="POMuswick.Views.ItemSearchPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:POMuswick.Controls"
    xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    xmlns:fftransformations="clr-namespace:FFImageLoading.Transformations;assembly=FFImageLoading.Maui"
    xmlns:local="clr-namespace:POMuswick.ViewModels"
    Title="Search Products"
    HideSoftInputOnTapped="True"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">


    <ContentPage.Content>
        <Grid Margin="{OnPlatform iOS='0,50,0,0', Android='0'}"
              SafeAreaEdges="{OnPlatform iOS='None', Android='All'}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!--  Header  -->
                <RowDefinition Height="Auto"/>
                <!--  Search Box  -->
                <RowDefinition Height="Auto"/>
                <!--  Category Labels (Fix: 120 is risky)  -->
                <RowDefinition Height="3"/>
                <!--  Divider  -->
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <!--  Footer  -->
            </Grid.RowDefinitions>

            <controls:CustomHeader Grid.Row="0"
                                   Title="{Binding title}"
                                   BackCommand="{Binding BackPressedCommand}"/>
            <StackLayout
                Grid.Row="1"
                HorizontalOptions="Center"
                Orientation="Horizontal"
                VerticalOptions="Center">
                <Entry
                    x:Name="Search"
                    Margin="0,0,0,0"
                    ClearButtonVisibility="WhileEditing"
                    Completed="OnTappedSearch"
                    FontSize="14"
                    HeightRequest="36"
                    HorizontalOptions="Start"
                    IsSpellCheckEnabled="False"
                    IsTextPredictionEnabled="False"
                    Placeholder="Enter Search Text"
                    PlaceholderColor="Gray"
                    Text="{Binding SearchText , Mode=TwoWay}"
                    VerticalOptions="Center"
                    WidthRequest="250"/>
                <Image
                    Margin="10,0,0,0"
                    HeightRequest="20"
                    WidthRequest="20">
                    <Image.Source>
                        <FontImageSource
                            FontFamily="FontAwesomeFreeSolid"
                            Glyph="&#xF002;"
                            Size="12"
                            Color="Blue"/>
                    </Image.Source>
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="{Binding RefreshList}"/>
                    </Image.GestureRecognizers>
                </Image>
            </StackLayout>
            <StackLayout
                Grid.Row="2"
                Orientation="Vertical"
                Spacing="0"
                VerticalOptions="Start">
                <BoxView
                    BackgroundColor="gray"
                    HeightRequest="3"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    Color="lightgray"/>
                <StackLayout
                    Margin="0,10,0,0"
                    HorizontalOptions="Center"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <Label
                        Margin="0,0,0,0"
                        FontAttributes="Bold"
                        FontSize="16"
                        HorizontalOptions="Center"
                        Text="{Binding Category}"
                        TextColor="black"
                        TextDecorations="Underline">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="{Binding Category}"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <Frame
                        Margin="10,0,0,0"
                        Padding="0,0,0,0"
                        BackgroundColor="#CDCDCD"
                        BorderColor="Transparent"
                        CornerRadius="5"
                        HeightRequest="20"
                        HorizontalOptions="Center"
                        IsVisible="false"
                        VerticalOptions="Center"
                        WidthRequest="20">
                        <Label
                            Margin="0,0,0,0"
                            BackgroundColor="#CDCDCD"
                            FontAttributes="Bold"
                            FontSize="12"
                            HeightRequest="20"
                            HorizontalTextAlignment="Center"
                            Text="X"
                            TextColor="Black"
                            VerticalTextAlignment="Center"
                            WidthRequest="20">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="{Binding ClearCategory}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Frame>
                </StackLayout>
                <StackLayout
                    Margin="0,0,0,7"
                    HorizontalOptions="Center"
                    Orientation="Horizontal"
                    VerticalOptions="Center">
                    <CheckBox
                        x:Name="InStockOnly"
                        Margin="20,0,0,0"
                        CheckedChanged="{Binding RefreshList}"
                        IsChecked="{Binding InStockOnlyValue}"
                        VerticalOptions="Center"
                        Color="Blue"/>
                    <Label
                        x:Name="InStockLabel"
                        Margin="0,2,0,0"
                        FontSize="12"
                        Text="Show In Stock Only"
                        TextColor="black"
                        VerticalOptions="Center"/>
                </StackLayout>
                <StackLayout
                    Margin="0,0,0,5"
                    HorizontalOptions="Center"
                    IsVisible="false"
                    Orientation="Horizontal"
                    VerticalOptions="Center">
                    <Label
                        Padding="0,7,0,10"
                        FontAttributes="Bold"
                        FontSize="16"
                        HorizontalOptions="Center"
                        Text="{Binding Subcategory}"
                        TextColor="black"
                        TextDecorations="Underline">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="{Binding Subcategory}"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <Frame
                        Margin="10,0,0,0"
                        Padding="0,0,0,0"
                        BackgroundColor="#CDCDCD"
                        BorderColor="Transparent"
                        CornerRadius="5"
                        HeightRequest="20"
                        HorizontalOptions="Center"
                        IsVisible="false"
                        VerticalOptions="Center"
                        WidthRequest="20">
                        <Label
                            Margin="0,0,0,0"
                            BackgroundColor="#CDCDCD"
                            FontAttributes="Bold"
                            FontSize="12"
                            HeightRequest="20"
                            HorizontalTextAlignment="Center"
                            Text="X"
                            TextColor="Black"
                            VerticalTextAlignment="Center"
                            WidthRequest="20">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="{Binding ClearCategory}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Frame>
                </StackLayout>
                <BoxView
                    Grid.Row="3"
                    BackgroundColor="gray"
                    HeightRequest="3"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    Color="lightgray"/>
            </StackLayout>
            <CollectionView
                x:Name="ItemsListSearch"
                Grid.Row="4"
                ItemSizingStrategy="MeasureFirstItem"
                SelectionMode="None"
                ItemsSource="{Binding LstItems}"
                VerticalOptions="Fill">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical"
                            ItemSpacing="0"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <controls:CustomSmallListItem
                            CommandParameter="{Binding .}"
                            ImageViewCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ShowImageCommand}"
                            PlusCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.IncreaseQtyCommand}"
                            MinusCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DecreaseQtyCommand}"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <controls:ImageAlertView
                x:Name="ImageAlert"
                Grid.Row="0"
                ImageSource="{Binding SelectedImage}"
                Grid.RowSpan="5"
                Grid.Column="0"
                ZIndex="99"/>

            <controls:CustomToolbar Grid.Row="5"
                                    HomeCommand="{Binding HomePressedCommand}"
                                    CartCommand="{Binding CartPressedCommand}"
                                    HistoryCommand="{Binding HistoryPressedCommand}"
                                    ShopCommand="{Binding ShopPressedCommand}"
                                    ScanCommand="{Binding ScanPressedCommand}"/>
        </Grid>
    </ContentPage.Content>
</ContentPage>
