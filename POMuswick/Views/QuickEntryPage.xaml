<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="POMuswick.Views.QuickEntryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:POMuswick.Controls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:ffImage="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    xmlns:barcode="clr-namespace:BarcodeScanning;assembly=BarcodeScanning.Native.Maui"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    Title="Quick Entry"
    Background="{StaticResource Surface}"
    HideSoftInputOnTapped="True"
    Shell.NavBarIsVisible="False">

    <ContentPage.Content>
        <Grid Margin="{OnPlatform iOS='0,50,0,0', Android='0'}"
              SafeAreaEdges="{OnPlatform iOS='None', Android='All'}"
              RowDefinitions="52, *, Auto">

            <!--  0. TOP NAVIGATION HEADER  -->
            <Grid Grid.Row="0"
                  HeightRequest="52"
                  Padding="16,0"
                  ColumnDefinitions="Auto, *"
                  ColumnSpacing="8"
                  VerticalOptions="Center">
                <Button
                    Grid.Column="0"
                    Command="{Binding BackPressedCommand}"
                    FontFamily="FontAwesomeFreeSolid"
                    FontSize="18"
                    Text="&#xF060;"
                    TextColor="{StaticResource Ink}"
                    Background="Transparent"
                    Padding="0"
                    WidthRequest="36"
                    HeightRequest="36"
                    VerticalOptions="Center"/>
                <Label
                    Grid.Column="1"
                    Margin="4,0,0,0"
                    Text="{Binding Title, FallbackValue='Quick Entry'}"
                    FontSize="19"
                    FontAttributes="Bold"
                    TextColor="{StaticResource Ink}"
                    VerticalOptions="Center"/>
            </Grid>

            <!--  1. SCROLLABLE CONTENT  -->
            <ScrollView Grid.Row="1">
                <VerticalStackLayout
                    Padding="16,10,16,20"
                    Spacing="14"
                    VerticalOptions="Start">

                    <!-- SCANNER VIEWFINDER CARD -->
                    <Border
                        StrokeShape="RoundRectangle 20"
                        Stroke="{StaticResource Divider}"
                        StrokeThickness="1"
                        Background="{StaticResource SurfaceAlt}"
                        HeightRequest="210"
                        WidthRequest="210"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                        <Grid>
                            <barcode:CameraView
                                x:Name="ScannerControl"
                                CameraEnabled="True"
                                HeightRequest="210"
                                WidthRequest="210"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                VibrationOnDetected="True"/>

                            <!-- Tap to Scan Overlay -->
                            <VerticalStackLayout
                                x:Name="TapToScan"
                                Spacing="6"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                IsVisible="{Binding TapToScanIsVisible}">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OnScannerEnableCommand}"/>
                                </VerticalStackLayout.GestureRecognizers>
                                <Label
                                    FontAttributes="Bold"
                                    FontFamily="FontAwesomePro6Regular"
                                    FontSize="44"
                                    HorizontalOptions="Center"
                                    Text="&#xF030;"
                                    TextColor="{StaticResource Primary}"/>
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    HorizontalOptions="Center"
                                    Text="Tap To Scan"
                                    TextColor="{StaticResource Primary}"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- MANUAL SEARCH & ENTRY BAR -->
                    <Border
                        Background="{StaticResource SurfaceAlt}"
                        Stroke="{StaticResource Divider}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="6,4"
                        HorizontalOptions="Fill">
                        <Grid ColumnDefinitions="*, Auto"
                              VerticalOptions="Center">
                            <Entry
                                x:Name="ScanItem"
                                Text="{Binding ScanItemText, Mode=TwoWay}"
                                FontSize="15"
                                HeightRequest="40"
                                Keyboard="Numeric"
                                Placeholder="Item # or UPC"
                                TextColor="{StaticResource Ink}"
                                BackgroundColor="Transparent"
                                Margin="8,0"
                                VerticalOptions="Center"/>
                            <Button
                                Grid.Column="1"
                                x:Name="EnterButton"
                                Background="{StaticResource Primary}"
                                Command="{Binding EnterButtonCommand}"
                                CornerRadius="8"
                                FontAttributes="Bold"
                                FontSize="13"
                                HeightRequest="36"
                                Padding="16,0"
                                Text="Enter"
                                TextColor="{StaticResource White}"
                                TextTransform="None"
                                VerticalOptions="Center"/>
                        </Grid>
                    </Border>

                    <!-- SYSTEM FEEDBACK / STATUS MESSAGE -->
                    <Label
                        x:Name="Message"
                        FontSize="14"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        IsVisible="{Binding MessageIsVisible}"
                        Text="{Binding MessageText}"
                        TextColor="{StaticResource Primary}"/>

                    <!-- SCANNED PRODUCT RESULT CARD -->
                    <Border
                        Background="{StaticResource SurfaceAlt}"
                        Stroke="{StaticResource Divider}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="14"
                        HorizontalOptions="Fill">
                        <Border.Shadow>
                            <Shadow Brush="#000000"
                                    Offset="0,3"
                                    Radius="8"
                                    Opacity="0.05"/>
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="10">

                            <!-- Header: Item Number & UPC Tags -->
                            <Grid ColumnDefinitions="Auto, Auto, *">
                                <Border
                                    Grid.Column="0"
                                    BackgroundColor="#F1F5F9"
                                    StrokeShape="RoundRectangle 6"
                                    StrokeThickness="0"
                                    Padding="8,3"
                                    VerticalOptions="Center">
                                    <Label
                                        x:Name="ItemNoDisplay"
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        Text="{Binding ItemNoDisplayText}"
                                        TextColor="Black"/>
                                </Border>

                                <Label
                                    Grid.Column="1"
                                    x:Name="ItemNoDisplayUPC"
                                    Margin="8,0,0,0"
                                    FontSize="12"
                                    Text="{Binding ItemNoDisplayUPCText}"
                                    TextColor="{StaticResource MutedInk}"
                                    VerticalOptions="Center"/>

                                <!-- Category Badge -->
                                <Label
                                    Grid.Column="2"
                                    FontSize="12"
                                    HorizontalOptions="End"
                                    Text="{Binding CategoryDesc}"
                                    TextColor="{StaticResource MutedInk}"
                                    VerticalOptions="Center"/>
                            </Grid>

                            <!-- Middle Section: Image + Info Hierarchy -->
                            <Grid ColumnDefinitions="100, *"
                                  ColumnSpacing="12">
                                <ffImage:CachedImage
                                    Grid.Column="0"
                                    x:Name="ImageURL"
                                    Aspect="AspectFit"
                                    DownsampleToViewSize="true"
                                    HeightRequest="90"
                                    WidthRequest="90"
                                    RetryCount="100"
                                    ErrorPlaceholder="logoicon.png"
                                    Source="{Binding ImageURLSource}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">
                                    <ffImage:CachedImage.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ShowImageCommand}"/>
                                    </ffImage:CachedImage.GestureRecognizers>
                                </ffImage:CachedImage>

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="4"
                                                     VerticalOptions="Center">
                                    <Label
                                        x:Name="Description"
                                        FontAttributes="Bold"
                                        FontSize="15"
                                        Text="{Binding DescriptionText}"
                                        TextColor="{StaticResource Ink}"
                                        MaxLines="2"
                                        LineBreakMode="TailTruncation"/>

                                    <!-- Price & UOM -->
                                    <HorizontalStackLayout Spacing="4"
                                                           VerticalOptions="End">
                                        <Label
                                            x:Name="PriceDisplay"
                                            FontAttributes="Bold"
                                            FontSize="20"
                                            Text="{Binding PriceDisplayText}"
                                            TextColor="Red"
                                            VerticalOptions="Center"/>
                                        <Label
                                            x:Name="SizeUOM"
                                            FontSize="12"
                                            Text="{Binding SizeUOMText}"
                                            TextColor="Red"
                                            Margin="0,0,0,2"
                                            VerticalOptions="End"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Stock & Order Limit Indicators -->
                            <HorizontalStackLayout
                                x:Name="StockRow"
                                IsVisible="{Binding StockRowIsVisible}"
                                Spacing="6"
                                VerticalOptions="Center">

                                <Label
                                    x:Name="QOHLabel"
                                    FontSize="12"
                                    Text="{Binding QOHLabelText}"
                                    TextColor="Black"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding QOHLabelIsVisible}"/>
                                <Label
                                    x:Name="QOHRed"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    Text="{Binding QOH}"
                                    TextColor="{StaticResource Primary}"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding QOHRedIsVisible}"/>
                                <Label
                                    x:Name="QOHBlack"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    Text="{Binding QOH}"
                                    TextColor="Black"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding QOHBlackIsVisible}"/>

                                <Border
                                    BackgroundColor="#DCFCE7"
                                    StrokeShape="RoundRectangle 6"
                                    StrokeThickness="0"
                                    Padding="6,2"
                                    IsVisible="{Binding QOHInStockIsVisible}"
                                    VerticalOptions="Center">
                                    <Label
                                        x:Name="QOHInStock"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        Text="In Stock"
                                        TextColor="#166534"/>
                                </Border>

                                <Border
                                    BackgroundColor="#FEE2E2"
                                    StrokeShape="RoundRectangle 6"
                                    StrokeThickness="0"
                                    Padding="6,2"
                                    IsVisible="{Binding QOHOutOfStockIsVisible}"
                                    VerticalOptions="Center">
                                    <Label
                                        x:Name="QOHOutOfStock"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        Text="Out Of Stock"
                                        TextColor="{StaticResource Primary}"/>
                                </Border>

                                <Label
                                    x:Name="MaxOrderQty"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    Text="{Binding MaxOrderQtyText}"
                                    TextColor="Black"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding MaxOrderQtyIsVisible}"/>
                            </HorizontalStackLayout>

                            <!-- Unified Capsule Stepper -->
                            <Border
                                x:Name="QuickEntryStepper"
                                HeightRequest="38"
                                Padding="0"
                                Background="{StaticResource SurfaceAlt}"
                                Stroke="{StaticResource Divider}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                IsVisible="{Binding QuickEntryStepperIsVisible}">
                                <Grid ColumnDefinitions="42, 1, 60, 1, 42"
                                      VerticalOptions="Fill">
                                    <ImageButton
                                        Grid.Column="0"
                                        x:Name="MinusButton"
                                        BackgroundColor="Transparent"
                                        Command="{Binding MinusButtonCommand}"
                                        HeightRequest="24"
                                        WidthRequest="24"
                                        Source="blue_minus.png"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"/>

                                    <BoxView Grid.Column="1"
                                             WidthRequest="1"
                                             Color="{StaticResource Divider}"
                                             VerticalOptions="Fill"/>

                                    <Label
                                        Grid.Column="2"
                                        x:Name="QtyStepper"
                                        FontAttributes="Bold"
                                        FontSize="18"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"
                                        Text="{Binding QtyStepperText}"
                                        TextColor="Black"/>

                                    <BoxView Grid.Column="3"
                                             WidthRequest="1"
                                             Color="{StaticResource Divider}"
                                             VerticalOptions="Fill"/>

                                    <ImageButton
                                        Grid.Column="4"
                                        x:Name="PlusButton"
                                        BackgroundColor="Transparent"
                                        Command="{Binding PlusButtonCommand}"
                                        HeightRequest="24"
                                        WidthRequest="24"
                                        Source="blue_plus.png"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"/>
                                </Grid>
                            </Border>

                            <!-- Action Buttons -->
                            <Button
                                x:Name="AddToOrderButton"
                                Background="{StaticResource Primary}"
                                Command="{Binding AddToOrderButtonCommand}"
                                CornerRadius="10"
                                FontAttributes="Bold"
                                FontSize="14"
                                HeightRequest="44"
                                HorizontalOptions="Fill"
                                Text="Add to Order"
                                TextColor="{StaticResource White}"
                                TextTransform="None"
                                IsVisible="{Binding AddToOrderButtonIsVisible}"/>

                            <Button
                                x:Name="UpdateOrderButton"
                                Background="{StaticResource Primary}"
                                Command="{Binding AddToOrderButtonCommand}"
                                CornerRadius="10"
                                FontAttributes="Bold"
                                FontSize="14"
                                HeightRequest="44"
                                HorizontalOptions="Fill"
                                Text="Update Qty"
                                TextColor="{StaticResource White}"
                                TextTransform="None"
                                IsVisible="{Binding UpdateOrderButtonIsVisible}"/>

                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

            <!--  2. BOTTOM TOOLBAR  -->
            <controls:CustomToolbar Grid.Row="2"
                                    HeightRequest="80"
                                    HomeCommand="{Binding HomePressedCommand}"
                                    CartCommand="{Binding CartPressedCommand}"
                                    HistoryCommand="{Binding HistoryPressedCommand}"
                                    ShopCommand="{Binding ShopPressedCommand}"
                                    ScanCommand="{Binding ScanPressedCommand}"/>
        </Grid>
    </ContentPage.Content>
</ContentPage>