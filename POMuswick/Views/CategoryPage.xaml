<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="POMuswick.Views.CategoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:POMuswick.Controls"
    xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    xmlns:fftransformations="clr-namespace:FFImageLoading.Transformations;assembly=FFImageLoading.Maui"
    xmlns:ios="http://schemas.microsoft.com/dotnet/2021/maui/ios"
    x:Name="CategoriesPage"
    Title="Product Categories"
    BackgroundColor="{StaticResource Surface}"
    HideSoftInputOnTapped="True">

    <Shell.SearchHandler>
        <controls:MySearchHandler
            DisplayMemberName="Name"
            Placeholder="Search Products"
            ShowsResults="false"/>
    </Shell.SearchHandler>

    <ContentPage.Content>
        <Grid Margin="{OnPlatform iOS='0,50,0,0', Android='0'}"
              SafeAreaEdges="{OnPlatform iOS='None', Android='All'}">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  HeightRequest="52"
                  Padding="14,0"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="8"
                  VerticalOptions="Center">
                <Button
                    Grid.Column="0"
                    Command="{Binding BackPressedCommand}"
                    FontFamily="FontAwesomeFreeSolid"
                    FontSize="18"
                    Text="&#xF060;"
                    TextColor="{StaticResource Ink}"
                    Background="Transparent"
                    Padding="0"
                    WidthRequest="36"
                    HeightRequest="36"
                    VerticalOptions="Center"/>
                <Label
                    Grid.Column="1"
                    Margin="4,0,0,0"
                    Text="{Binding Title, FallbackValue='Product Categories'}"
                    FontSize="19"
                    FontAttributes="Bold"
                    TextColor="{StaticResource Ink}"
                    VerticalOptions="Center"/>
            </Grid>

            <CollectionView
                x:Name="CategoriesListSearch"
                Grid.Row="1"
                ItemsSource="{Binding Categories}"
                SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <!--  Use a plain layout as the DataTemplate content for MAUI  -->
                        <Border
                            Margin="12,5"
                            Padding="10,9"
                            Background="{StaticResource White}"
                            Stroke="{StaticResource Divider}"
                            StrokeShape="RoundRectangle 16"
                            StrokeThickness="1">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CategoriesSelectedCommand}"
                                    CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                            <Border.Shadow>
                                <Shadow Brush="{StaticResource Ink}"
                                        Offset="0,3"
                                        Radius="8"
                                        Opacity="0.05"/>
                            </Border.Shadow>
                            <Grid ColumnDefinitions="78,*,Auto"
                                  ColumnSpacing="12">
                                <Border Grid.Column="0"
                                        Padding="0"
                                        Background="{StaticResource SurfaceAlt}"
                                        Stroke="{StaticResource Divider}"
                                        StrokeShape="RoundRectangle 10"
                                        StrokeThickness="1"
                                        HeightRequest="72"
                                        WidthRequest="72">
                                    <Label
                                        FontFamily="FontAwesomeFreeSolid"
                                        FontSize="30"
                                        Text="{Binding Description, Converter={StaticResource CategoryIconConverter}}"
                                        TextColor="{StaticResource Primary}"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="3"
                                                     VerticalOptions="Center">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        LineBreakMode="WordWrap"
                                        MaxLines="2"
                                        Text="{Binding Description}"
                                        TextColor="{StaticResource Ink}"
                                        VerticalOptions="Center"/>
                                    <Label
                                        FontSize="11"
                                        Text="Select to browse"
                                        TextColor="{StaticResource MutedInk}"/>
                                </VerticalStackLayout>
                                <Border Grid.Column="2"
                                        Padding="0"
                                        Background="{StaticResource SurfaceAlt}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 16"
                                        HeightRequest="30"
                                        WidthRequest="30"
                                        VerticalOptions="Center">
                                    <Label
                                        FontFamily="FontAwesomeFreeSolid"
                                        FontSize="12"
                                        Text="&#xF054;"
                                        TextColor="{StaticResource Primary}"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <controls:CustomToolbar Grid.Row="2"
                                    HomeCommand="{Binding HomePressedCommand}"
                                    CartCommand="{Binding CartPressedCommand}"
                                    HistoryCommand="{Binding HistoryPressedCommand}"
                                    ShopCommand="{Binding ShopPressedCommand}"
                                    ScanCommand="{Binding ScanPressedCommand}"/>
        </Grid>
    </ContentPage.Content>
</ContentPage>
