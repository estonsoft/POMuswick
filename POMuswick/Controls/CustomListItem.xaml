<ContentView
    x:Class="POMuswick.Controls.CustomListItem"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:POMuswick.Controls"
    xmlns:ff="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui">

    <Border
        Margin="10,8"
        Padding="12"
        BackgroundColor="{StaticResource White}"
        Stroke="{StaticResource Divider}"
        StrokeShape="RoundRectangle 12"
        StrokeThickness="1">

        <Border.Shadow>
            <Shadow
                Brush="{StaticResource PrimaryBrush}"
                Opacity="0.08"
                Radius="10"
                Offset="0,3"/>
        </Border.Shadow>

        <Grid ColumnDefinitions="92,*,Auto"
              RowDefinitions="Auto,Auto,Auto"
              ColumnSpacing="12"
              RowSpacing="8">

            <Label
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                FontAttributes="Bold"
                FontSize="16"
                Padding="0,0,0,4"
                Text="{Binding Description}"
                TextColor="{StaticResource Tertiary}"/>

            <Border
                Grid.Row="1"
                Grid.Column="0"
                Padding="4"
                BackgroundColor="{StaticResource White}"
                Stroke="{StaticResource Divider}"
                StrokeShape="RoundRectangle 10"
                StrokeThickness="1"
                HeightRequest="88"
                WidthRequest="88">
                <ff:CachedImage
                    x:Name="ItemImage"
                    Aspect="AspectFit"
                    ErrorPlaceholder="logoicon.png"
                    HeightRequest="80"
                    RetryCount="0"
                    CacheType="All"
                    CacheDuration="30.00:00:00"
                    DownsampleToViewSize="True"
                    Source="{Binding ImageURL}"
                    WidthRequest="80">
                    <ff:CachedImage.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={x:Reference Root}, Path=ImageViewCommand}"
                            CommandParameter="{Binding Source={x:Reference ItemImage}, Path=Source}"/>
                    </ff:CachedImage.GestureRecognizers>
                </ff:CachedImage>
            </Border>

            <VerticalStackLayout
                Grid.Row="1"
                Grid.Column="1"
                Spacing="3">

                <Label
                    FontAttributes="Bold"
                    FontSize="14"
                    Text="{Binding ItemNoDisplay}"
                    TextColor="{StaticResource Ink}"/>

                <Label
                    FontSize="12"
                    Text="{Binding ItemNoDisplayUPC}"
                    TextColor="{StaticResource MutedInk}"/>

                <Label
                    FontSize="13"
                    Text="{Binding CategoryDesc}"
                    TextColor="{StaticResource MutedInk}"/>

                <HorizontalStackLayout IsVisible="{Binding IsStockRowVisible}"
                                       Spacing="6">
                    <Label
                        FontSize="12"
                        IsVisible="{Binding IsQOHVisible}"
                        Text="QOH:"
                        TextColor="{StaticResource MutedInk}"/>
                    <Label
                        FontAttributes="Bold"
                        FontSize="12"
                        IsVisible="{Binding IsQOHRedVisible}"
                        Text="{Binding QOH}"
                        TextColor="{StaticResource Primary}"/>
                    <Label
                        FontAttributes="Bold"
                        FontSize="12"
                        IsVisible="{Binding IsQOHBlackVisible}"
                        Text="{Binding QOH}"
                        TextColor="{StaticResource Ink}"/>
                    <Label
                        FontSize="11"
                        IsVisible="{Binding IsInStockVisible}"
                        Text="In Stock"
                        TextColor="{StaticResource Primary}"/>
                    <Label
                        FontSize="11"
                        IsVisible="{Binding IsOutOfStockVisible}"
                        Text="Out Of Stock"
                        TextColor="{StaticResource Primary}"/>
                    <Label
                        FontSize="11"
                        IsVisible="{Binding IsMaxOrderQtyVisible}"
                        Text="{Binding MaxOrderQtyDisplay}"
                        TextColor="{StaticResource MutedInk}"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="6">
                    <Label
                        FontAttributes="Bold"
                        FontSize="16"
                        IsVisible="{Binding IsPriceVisible}"
                        Text="{Binding PriceDisplay}"
                        TextColor="{StaticResource Primary}"/>
                    <Label
                        FontSize="14"
                        Text="{Binding SizeUOM}"
                        TextColor="{StaticResource Ink}"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <controls:CustomStepper
                x:Name="stepper"
                Grid.Row="1"
                Grid.Column="2"
                Margin="0,0,8,0"
                PlusCommand="{Binding Source={x:Reference Root}, Path=PlusCommand}"
                MinusCommand="{Binding Source={x:Reference Root}, Path=MinusCommand}"
                CommandParameter="{Binding Source={x:Reference Root}, Path=CommandParameter}"
                HorizontalOptions="End"
                IsStepperVisible="{Binding IsStepperVisible}"
                IsAddToOrderVisible="{Binding IsAddToOrderVisible}"
                IsMaxOrderQtyVisible="{Binding IsMaxOrderQtyVisible}"
                ItemNo="{Binding ItemNo}"
                MaxOrderQty="{Binding MaxOrderQty}"
                Text="{Binding QtyOrder}"
                UOM="{Binding UOM}"
                VerticalOptions="Center"/>
        </Grid>
    </Border>

    <VisualStateManager.VisualStateGroups>
        <VisualStateGroupList>
            <VisualStateGroup Name="CommonStates">
                <VisualState Name="Normal"/>
                <VisualState Name="Selected">
                    <VisualState.Setters>
                        <Setter Property="Opacity"
                                Value="0.92"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateGroupList>
    </VisualStateManager.VisualStateGroups>
</ContentView>
