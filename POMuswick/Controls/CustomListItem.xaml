<ContentView
    x:Class="POMuswick.Controls.CustomListItem"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:POMuswick.Controls"
    xmlns:ff="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui">

    <Grid ColumnDefinitions="*,*,*"
          RowDefinitions="*,*,*,*,*">
        <!--  TITLE  -->
        <Label
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Padding="10"
            FontAttributes="Bold"
            FontSize="16"
            Text="{Binding Description}"
            TextColor="RoyalBlue"/>

        <!--  IMAGE  -->
        <!-- <ff:CachedImage
            Grid.Row="1"
            Grid.Column="0"
            Margin="10"
            Aspect="AspectFit"
            ErrorPlaceholder="logoicon.png"
            HeightRequest="90"
            RetryCount="0"
            LoadingPlaceholder="loading_spinner.gif"
            CacheType="All"
            CacheDuration="30.00:00:00"
            DownsampleToViewSize="True"
            Source="{Binding ImageURL}"
            WidthRequest="90">
            <ff:CachedImage.GestureRecognizers>
                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
            </ff:CachedImage.GestureRecognizers>
        </ff:CachedImage> -->
        <Grid Grid.Row="1"
              Grid.Column="0"
              Margin="10"
              HeightRequest="90"
              WidthRequest="90">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
            </Grid.GestureRecognizers>
            <!-- 1. Native Image with built-in Caching -->
            <Image x:Name="MyImage"
                   Aspect="AspectFit"
                   HeightRequest="90"
                   WidthRequest="90"
                   Source="{Binding ImageURL}">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                </Image.GestureRecognizers>
            </Image>

            <!-- 2. Spinner that displays ONLY while the image is downloading -->
            <ActivityIndicator IsRunning="{Binding Source={x:Reference MyImage}, Path=IsLoading}"
                               IsVisible="{Binding Source={x:Reference MyImage}, Path=IsLoading}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Color="Gray"/>
        </Grid>

        <!--  DETAILS  -->
        <VerticalStackLayout
            Grid.Row="1"
            Grid.Column="1"
            Spacing="2">

            <Label
                FontAttributes="Bold"
                FontSize="14"
                Text="{Binding ItemNoDisplay}"
                TextColor="Black"/>
            <Label FontSize="12"
                   Text="{Binding ItemNoDisplayUPC}"/>
            <Label FontSize="14"
                   Text="{Binding CategoryDesc}"/>

            <!--  STOCK  -->
            <HorizontalStackLayout IsVisible="{Binding IsStockRowVisible}"
                                   Spacing="4">
                <Label
                    FontSize="14"
                    IsVisible="{Binding IsQOHVisible}"
                    Text="QOH:"/>
                <Label
                    FontAttributes="Bold"
                    FontSize="14"
                    IsVisible="{Binding IsQOHRedVisible}"
                    Text="{Binding QOH}"
                    TextColor="Red"/>
                <Label
                    FontAttributes="Bold"
                    FontSize="14"
                    IsVisible="{Binding IsQOHBlackVisible}"
                    Text="{Binding QOH}"/>
                <Label
                    FontSize="12"
                    IsVisible="{Binding IsInStockVisible}"
                    Text="In Stock"/>
                <Label
                    FontSize="12"
                    IsVisible="{Binding IsOutOfStockVisible}"
                    Text="Out Of Stock"
                    TextColor="Red"/>
                <Label
                    BackgroundColor="White"
                    FontSize="12"
                    IsVisible="{Binding IsMaxOrderQtyVisible}"
                    Text="{Binding MaxOrderQtyDisplay}"
                    TextColor="Black"/>
            </HorizontalStackLayout>
            <!--  PRICE  -->
            <HorizontalStackLayout
                Grid.Row="2"
                Grid.ColumnSpan="3"
                Spacing="4">
                <Label
                    BackgroundColor="White"
                    FontAttributes="Bold"
                    FontSize="18"
                    IsVisible="{Binding IsPriceVisible}"
                    Text="{Binding PriceDisplay}"/>
                <Label
                    BackgroundColor="White"
                    FontSize="16"
                    Text="{Binding SizeUOM}"
                    TextColor="Black"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <controls:CustomStepper
            x:Name="stepper"
            Grid.Row="1"
            Grid.Column="2"
            Margin="0,0,0,20"
            HorizontalOptions="End"
            IsAddToOrderVisible="{Binding IsAddToOrderVisible}"
            IsStepperVisible="{Binding IsStepperVisible}"
            ItemNo="{Binding ItemNo}"
            MaxOrderQty="{Binding MaxOrderQty}"
            Text="{Binding QtyOrder}"
            UOM="{Binding UOM}"
            VerticalOptions="End"/>

        <!--  DIVIDER  -->
        <BoxView
            Grid.Row="4"
            Grid.ColumnSpan="3"
            BackgroundColor="gray"
            HeightRequest="1"
            Color="LightGray"/>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroupList>
                <VisualStateGroup Name="CommonStates">
                    <!--  Normal State  -->
                    <VisualState Name="Normal"/>

                    <!--  Selected State  -->
                    <VisualState Name="Selected">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor"
                                    Value="LightGray"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</ContentView>
