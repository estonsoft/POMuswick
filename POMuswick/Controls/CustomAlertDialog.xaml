<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="POMuswick.Controls.CustomAlertDialog"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="this">

    <!--  Dim overlay  -->
    <Grid BackgroundColor="#80000000">
        <Border
            Padding="24"
            BackgroundColor="White"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            WidthRequest="300">

            <StackLayout Spacing="16">

                <!--  Activity Indicator  -->
                <ActivityIndicator
                    x:Name="LoadingIndicator"
                    HeightRequest="36"
                    HorizontalOptions="Center"
                    IsRunning="{Binding IsLoading, Source={x:Reference this}}"
                    IsVisible="{Binding IsLoading, Source={x:Reference this}}"
                    WidthRequest="36"
                    Color="#378ADD" />

                <!--  Title  -->
                <Label
                    x:Name="TitleLabel"
                    FontAttributes="Bold"
                    FontSize="20"
                    HorizontalTextAlignment="Center"
                    Text="{Binding Title, Source={x:Reference this}}"
                    TextColor="#111111" />

                <!--  Message  -->
                <Label
                    x:Name="MessageLabel"
                    FontSize="16"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="WordWrap"
                    Text="{Binding Message, Source={x:Reference this}}"
                    TextColor="#666666" />

            </StackLayout>
        </Border>
    </Grid>
</ContentView>