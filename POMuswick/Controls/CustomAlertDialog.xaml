<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="POMuswick.Controls.CustomAlertDialog"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="this">

    <Grid BackgroundColor="#66000000">

        <Border
            Padding="24"
            BackgroundColor="{StaticResource SurfaceAlt}"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            WidthRequest="340"
            Stroke="{StaticResource Divider}"
            StrokeShape="RoundRectangle 16"
            StrokeThickness="1">

            <Border.Shadow>
                <Shadow
                    Brush="{StaticResource PrimaryBrush}"
                    Opacity="0.18"
                    Radius="18"
                    Offset="0,8"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="14">

                <!-- Loading -->
                <ActivityIndicator
                    HeightRequest="36"
                    HorizontalOptions="Center"
                    IsRunning="{Binding IsLoading, Source={x:Reference this}}"
                    IsVisible="{Binding IsLoading, Source={x:Reference this}}"
                    WidthRequest="36"
                    Color="{StaticResource Primary}"/>

                <!-- Title -->
                <Label
                    FontAttributes="Bold"
                    FontSize="20"
                    HorizontalTextAlignment="Center"
                    Text="{Binding Title, Source={x:Reference this}}"
                    TextColor="{StaticResource Ink}"/>

                <!-- Current operation -->
                <Label
                    FontSize="15"
                    HorizontalTextAlignment="Center"
                    Text="{Binding SyncStatus, Source={x:Reference this}}"
                    TextColor="{StaticResource MutedInk}"/>

                <!-- Percentage -->
                <Label
                    FontAttributes="Bold"
                    FontSize="28"
                    HorizontalTextAlignment="Center"
                    Text="{Binding ProgressPercentage, Source={x:Reference this}, StringFormat='{0}%'}"
                    TextColor="{StaticResource Primary}"/>

                <!-- Progress bar -->
                <ProgressBar
                    Progress="{Binding ProgressValue, Source={x:Reference this}}"
                    ProgressColor="{StaticResource Primary}"
                    BackgroundColor="{StaticResource Gray200}"
                    HeightRequest="8"/>

                <!-- Optional message -->
                <Label
                    FontSize="14"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="WordWrap"
                    Text="{Binding Message, Source={x:Reference this}}"
                    TextColor="{StaticResource MutedInk}"/>

            </VerticalStackLayout>

        </Border>

    </Grid>
</ContentView>