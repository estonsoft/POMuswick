<ContentView
    x:Class="POMuswick.Controls.HomePageCells"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:POMuswick.Controls"
    xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    x:Name="this">
    <Grid Padding="6,8">
        <Border BackgroundColor="{StaticResource White}"
                StrokeThickness="1"
                Stroke="{StaticResource Divider}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16"/>
            </Border.StrokeShape>

            <Border.Shadow>
                <Shadow Brush="{StaticResource Ink}"
                        Offset="0,4"
                        Radius="10"
                        Opacity="0.06"/>
            </Border.Shadow>

            <Grid Padding="10"
                  RowDefinitions="Auto, Auto, Auto, Auto, Auto"
                  RowSpacing="10">

                <!-- 1. Header Row: SKU Badge + Stock Indicators -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="Auto, *">
                    <!-- SKU / Item Number Tag -->
                    <Border Grid.Column="0"
                            BackgroundColor="{StaticResource SurfaceAlt}"
                            StrokeShape="RoundRectangle 6"
                            StrokeThickness="0"
                            Padding="8,3"
                            HorizontalOptions="Start"
                            VerticalOptions="Center">
                        <Label Text="{Binding ItemNoDisplay}"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource MutedInk}"/>
                    </Border>

                    <!-- Stock Status Badges & Info -->
                    <HorizontalStackLayout Grid.Column="1"
                                           HorizontalOptions="End"
                                           VerticalOptions="Center"
                                           Spacing="6"
                                           IsVisible="{Binding IsStockRowVisible}">

                        <!-- In Stock Chip -->
                        <Border BackgroundColor="{StaticResource SurfaceAlt}"
                                StrokeShape="RoundRectangle 6"
                                StrokeThickness="0"
                                Padding="6,2"
                                IsVisible="{Binding IsInStockVisible}">
                            <Label Text="In Stock"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"/>
                        </Border>

                        <!-- Out of Stock Chip -->
                        <Border BackgroundColor="#FEE2E2"
                                StrokeShape="RoundRectangle 6"
                                StrokeThickness="0"
                                Padding="6,2"
                                IsVisible="{Binding IsOutOfStockVisible}">
                            <Label Text="Out of Stock"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#991B1B"/>
                        </Border>

                        <!-- QOH Indicator -->
                        <HorizontalStackLayout Spacing="3"
                                               VerticalOptions="Center">
                            <Label Text="QOH:"
                                   FontSize="11"
                                   TextColor="{StaticResource MutedInk}"
                                   IsVisible="{Binding IsQOHVisible}"
                                   VerticalOptions="Center"/>
                            <Label Text="{Binding QOH}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#EF4444"
                                   IsVisible="{Binding IsQOHRedVisible}"
                                   VerticalOptions="Center"/>
                            <Label Text="{Binding QOH}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Ink}"
                                   IsVisible="{Binding IsQOHBlackVisible}"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>
                </Grid>

                <!-- 2. Product Image -->
                <Border Grid.Row="1"
                        BackgroundColor="{StaticResource SurfaceAlt}"
                        Stroke="{StaticResource Divider}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="6"
                        HeightRequest="90"
                        HorizontalOptions="Fill">
                    <ffimageloading:CachedImage
                        Source="{Binding ImageURL}"
                        Aspect="AspectFit"
                        CacheType="All"
                        DownsampleToViewSize="true"
                        LoadingPlaceholder="placeholder.png"
                        ErrorPlaceholder="placeholder.png"
                        RetryCount="1"
                        TransformPlaceholders="True"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        HeightRequest="72"
                        WidthRequest="72"/>
                </Border>

                <!-- 3. Category (Preserved functionality) -->
                <Label Grid.Row="2"
                       Text="{Binding CategoryDesc}"
                       FontSize="11"
                       TextColor="{StaticResource MutedInk}"
                       FontAttributes="None"
                       IsVisible="{Binding CategoryDesc, Converter={StaticResource StringNotEmptyConverter}}"/>

                <!-- 4. Product Description & Max Order Rule -->
                <VerticalStackLayout Grid.Row="3"
                                     Spacing="4">
                    <Label Text="{Binding Description}"
                           FontSize="14"
                           FontAttributes="Bold"
                           HorizontalOptions="Start"
                           TextColor="{StaticResource Ink}"
                           LineBreakMode="TailTruncation"
                           MaximumWidthRequest="200"
                           MaxLines="2"
                           LineHeight="1.2"/>

                    <Label Text="{Binding MaxOrderQtyDisplay}"
                           FontSize="11"
                           TextColor="#D97706"
                           FontAttributes="Bold"
                           IsVisible="{Binding IsMaxOrderQtyVisible}"/>
                </VerticalStackLayout>

                <!-- 5. Bottom Action Row: Pricing on Left, Stepper on Right -->
                <Grid Grid.Row="4"
                      ColumnDefinitions="*, Auto"
                      ColumnSpacing="12"
                      VerticalOptions="Center"
                      Margin="0,4,0,0">

                    <!-- Price & UOM Display -->
                    <VerticalStackLayout Grid.Column="0"
                                         Spacing="0"
                                         VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="3"
                                               VerticalOptions="End">
                            <Label Text="{Binding PriceDisplay}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Ink}"
                                   VerticalOptions="Center"/>
                            <Label Text="{Binding SizeUOM}"
                                   FontSize="12"
                                   TextColor="{StaticResource MutedInk}"
                                   Margin="0,0,0,2"
                                   VerticalOptions="End"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Stepper Control -->
                    <controls:CustomStepper
                        Grid.Column="1"
                        HorizontalOptions="End"
                        VerticalOptions="Center"
                        IsAddToOrderVisible="{Binding IsAddToOrderVisible}"
                        IsStepperVisible="{Binding IsStepperVisible}"
                        IsMaxOrderQtyVisible="{Binding IsMaxOrderQtyVisible}"
                        ItemNo="{Binding ItemNo}"
                        MaxOrderQty="{Binding MaxOrderQty}"
                        Text="{Binding QtyOrder}"
                        QtyOrder="{Binding QtyOrder}"
                        UOM="{Binding UOM}"
                        PlusCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.IncreaseQtyCommand}"
                        MinusCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DecreaseQtyCommand}"
                        CommandParameter="{Binding .}"/>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</ContentView>