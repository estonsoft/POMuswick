<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="POMuswick.Controls.CustomSmallListItem"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:POMuswick.Controls"
    xmlns:ff="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui">

    <Grid
        Padding="5"
        ColumnDefinitions="70,*,Auto"
        RowDefinitions="Auto,Auto">

        <!-- DESCRIPTION -->

        <Label
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            FontAttributes="Bold"
            FontSize="12"
            Text="{Binding Description}"
            TextColor="RoyalBlue"
            LineBreakMode="TailTruncation" />

        <!-- IMAGE -->

        <Border
            Grid.Row="1"
            Grid.Column="0"
            StrokeThickness="0"
            Padding="0"
            VerticalOptions="Start">

            <ff:CachedImage
                WidthRequest="60"
                HeightRequest="60"
                Aspect="AspectFit"
                Source="{Binding ImageURL}"
                ErrorPlaceholder="logoicon.png"
                LoadingPlaceholder="logoicon.png">

                <ff:CachedImage.GestureRecognizers>

                    <TapGestureRecognizer
                        Command="{Binding Source={x:Reference Root}, Path=ImageViewCommand}"
                        CommandParameter="{Binding Source={x:Reference Root}, Path=CommandParameter}" />

                </ff:CachedImage.GestureRecognizers>

            </ff:CachedImage>

        </Border>

        <!-- DETAILS -->

        <VerticalStackLayout
            Grid.Row="1"
            Grid.Column="1"
            Margin="10,0"
            Spacing="2">

            <!-- Item No -->

            <Label
                FontSize="10"
                FontAttributes="Bold"
                Text="{Binding ItemNoDisplay}"
                TextColor="Black" />

            <!-- UPC -->

            <Label
                FontSize="10"
                Text="{Binding ItemNoDisplayUPC}"
                TextColor="Gray" />

            <!-- Category -->

            <Label
                FontSize="10"
                Text="{Binding CategoryDesc}"
                TextColor="Gray" />

            <!-- STOCK -->

            <HorizontalStackLayout
                Spacing="4"
                IsVisible="{Binding IsStockRowVisible}">

                <Label
                    Text="QOH:"
                    FontSize="10"
                    IsVisible="{Binding IsQOHVisible}" />

                <Label
                    Text="{Binding QOH}"
                    FontSize="10"
                    FontAttributes="Bold"
                    TextColor="Black"
                    IsVisible="{Binding IsQOHBlackVisible}" />

                <Label
                    Text="{Binding QOH}"
                    FontSize="10"
                    FontAttributes="Bold"
                    TextColor="Red"
                    IsVisible="{Binding IsQOHRedVisible}" />

                <Label
                    Text="In Stock"
                    FontSize="10"
                    TextColor="Green"
                    IsVisible="{Binding IsInStockVisible}" />

                <Label
                    Text="Out Of Stock"
                    FontSize="10"
                    TextColor="Red"
                    IsVisible="{Binding IsOutOfStockVisible}" />

                <Label
                    Text="{Binding MaxOrderQtyDisplay}"
                    FontSize="10"
                    TextColor="Black"
                    IsVisible="{Binding IsMaxOrderQtyVisible}" />

            </HorizontalStackLayout>

            <!-- PRICE -->

            <HorizontalStackLayout
                Spacing="6">

                <Label
                    FontAttributes="Bold"
                    FontSize="14"
                    Text="{Binding PriceDisplay}"
                    IsVisible="{Binding IsPriceVisible}" />

                <Label
                    FontSize="12"
                    Text="{Binding SizeUOM}" />

            </HorizontalStackLayout>

        </VerticalStackLayout>

        <!-- STEPPER -->

        <controls:CustomSmallStepper
            Grid.Row="1"
            Grid.Column="2"
            VerticalOptions="Center"
            HorizontalOptions="End"

            QtyOrder="{Binding QtyOrder}"
            ItemNo="{Binding ItemNo}"
            MaxOrderQty="{Binding MaxOrderQty}"
            UOM="{Binding UOM}"

            IsStepperVisible="{Binding IsStepperVisible}"
            IsAddToOrderVisible="{Binding IsAddToOrderVisible}"

            PlusCommand="{Binding Source={x:Reference Root}, Path=PlusCommand}"
            MinusCommand="{Binding Source={x:Reference Root}, Path=MinusCommand}"

            CommandParameter="{Binding Source={x:Reference Root}, Path=CommandParameter}" />

        <!-- Divider -->

        <BoxView
            Grid.Row="2"
            Grid.ColumnSpan="3"
            Margin="0,8,0,0"
            HeightRequest="1"
            Color="LightGray" />

    </Grid>

    <!-- Selection State -->

    <VisualStateManager.VisualStateGroups>

        <VisualStateGroup>

            <VisualState Name="Normal" />

            <VisualState Name="Selected">

                <VisualState.Setters>

                    <Setter
                        Property="BackgroundColor"
                        Value="#EFEFEF" />

                </VisualState.Setters>

            </VisualState>

        </VisualStateGroup>

    </VisualStateManager.VisualStateGroups>

</ContentView>