<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="POMuswick.Controls.ImageAlertView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ff="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    x:Name="this"
    IsVisible="False">

    <!--  Dim Overlay  -->
    <Grid BackgroundColor="#AA000000">

        <Border
            Padding="0"
            BackgroundColor="White"
            HorizontalOptions="Center"
            Stroke="Transparent"
            StrokeShape="RoundRectangle 16"
            VerticalOptions="Center"
            WidthRequest="300">

            <VerticalStackLayout Spacing="0">

                <!--  Header Row  -->
                <Grid
                    Padding="14,12"
                    BackgroundColor="White"
                    ColumnDefinitions="*,Auto">

                    <Label
                        Grid.Column="0"
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="Product Image Preview"
                        TextColor="#111111"
                        VerticalOptions="Center" />

                    <!--  X Close Button  -->
                    <Border
                        Grid.Column="1"
                        BackgroundColor="#F2F2F2"
                        HeightRequest="50"
                        HorizontalOptions="End"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 20"
                        VerticalOptions="Center"
                        WidthRequest="50">
                        <Label
                            FontFamily="FontAwesomeFreeSolid"
                            FontSize="24"
                            HorizontalOptions="Center"
                            Text="&#xF00D;"
                            TextColor="#555555"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCloseTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>

                </Grid>

                <!--  Divider  -->
                <BoxView HeightRequest="0.5" Color="#E0E0E0" />

                <!--  Full Image via CachedImage  -->
                <ff:CachedImage
                    x:Name="PreviewImage"
                    Margin="12"
                    Aspect="AspectFit"
                    ErrorPlaceholder="logoicon.png"
                    HeightRequest="280"
                    LoadingPlaceholder="logoicon.png"
                    WidthRequest="280" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>